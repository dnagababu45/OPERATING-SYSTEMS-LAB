        #include <stdio.h>

int main() {
    int n, f, method, disk[100] = {0};
    int i, j, start = -1, count = 0;

    printf("Enter disk size: ");
    scanf("%d", &n);
    printf("Enter file size: ");
    scanf("%d", &f);
    printf("1. Contiguous  2. Linked  3. Indexed\n");
    printf("Enter method: ");
    scanf("%d", &method);

    if (f > n) {
        printf("Allocation failed!\n");
        return 0;
    }

    if (method == 1) {              // Contiguous
        for (i = 0; i <= n-f; i++) {
            count = 0;
            for (j = i; j < i+f; j++)
                if (disk[j] == 0) count++;
            if (count == f) {
                start = i;
                break;
            }
        }

        if (start == -1)
            printf("Allocation failed: No continuous space!\n");
        else {
            printf("Allocated blocks: ");
            for (i = start; i < start+f; i++)
                printf("%d ", i);
        }
    }
    else if (method == 2) {         // Linked
        printf("Allocated blocks: ");
        for (i = 0; i < n && count < f; i++)
            if (disk[i] == 0) {
                printf("%d ", i);
                count++;
            }
        if (count < f) printf("\nAllocation failed!");
    }
    else if (method == 3) {         // Indexed
        printf("Index block: 0\nAllocated blocks: ");
        for (i = 1; i <= f; i++)
            printf("%d ", i);
    }
    else
        printf("Invalid method!");

    return 0;
}

