           #include <stdio.h>
#include <stdlib.h>

void fcfs(int a[], int n, int h) {
    int i, total = 0, p = h;
    printf("\nFCFS: %d ", h);
    for (i = 0; i < n; i++) {
        total += abs(p-a[i]);
        p = a[i];
        printf("%d ", p);
    }
    printf("\nSeek Time = %d\n", total);
}

void sstf(int a[], int n, int h) {
    int v[50], used[50]={0}, i, j, p=h, total=0, min, k;
    for(i=0;i<n;i++) v[i]=a[i];

    printf("\nSSTF: %d ", h);
    for(i=0;i<n;i++) {
        min=9999; k=-1;
        for(j=0;j<n;j++)
            if(!used[j] && abs(p-v[j])<min)
                min=abs(p-v[j]), k=j;

        used[k]=1;
        total+=min;
        p=v[k];
        printf("%d ",p);
    }
    printf("\nSeek Time = %d\n",total);
}

void scan(int a[], int n, int h, int size) {
    int i,j,t,total=0,p=h;
    for(i=0;i<n;i++)
        for(j=i+1;j<n;j++)
            if(a[i]>a[j]) {
                t=a[i]; a[i]=a[j]; a[j]=t;
            }

    printf("\nSCAN: %d ",h);

    for(i=0;i<n;i++)
        if(a[i]>=h) {
            total+=abs(p-a[i]);
            p=a[i];
            printf("%d ",p);
        }

    total += size-1-p;
    p=size-1;
    printf("%d ",p);

    for(i=n-1;i>=0;i--)
        if(a[i]<h) {
            total+=abs(p-a[i]);
            p=a[i];
            printf("%d ",p);
        }

    printf("\nSeek Time = %d\n",total);
}

int main() {
    int a[50], n, h, size, i;

    printf("Enter disk size: ");
    scanf("%d",&size);
    printf("Enter number of requests: ");
    scanf("%d",&n);
    printf("Enter requests: ");
    for(i=0;i<n;i++) scanf("%d",&a[i]);
    printf("Enter initial head: ");
