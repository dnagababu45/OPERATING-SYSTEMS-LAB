#include <stdio.h>

int main() {
    FILE *fp;

    fp=fopen("data.txt","w");
    fprintf(fp,"Hello File");
    fclose(fp);

    fp=fopen("data.txt","r");
    printf("Data: ");
    char ch;
    while((ch=fgetc(fp))!=EOF)
        putchar(ch);
    fclose(fp);

    rename("data.txt","newdata.txt");
    remove("newdata.txt");

    printf("\nFile operations completed.");
    return 0;
}
