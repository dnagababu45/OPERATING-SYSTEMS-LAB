#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>

sem_t s;

void *process(void *p) {
    int id=*(int*)p;

    sem_wait(&s);
    printf("Process %d entered critical section\n",id);
    printf("Process %d completed\n",id);
    sem_post(&s);

    return NULL;
}

int main() {
    pthread_t t1,t2;
    int a=1,b=2;

    sem_init(&s,0,1);
    pthread_create(&t1,NULL,process,&a);
    pthread_create(&t2,NULL,process,&b);
    pthread_join(t1,NULL);
    pthread_join(t2,NULL);

    return 0;
}
