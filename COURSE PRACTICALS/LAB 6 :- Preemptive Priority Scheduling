            #include <stdio.h>

int main() {
    int n, i, time = 0, completed = 0;
    int at[20], bt[20], rt[20], pri[20];
    int wt[20], tat[20], min, index;
    float awt = 0, atat = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("Enter Arrival Time, Burst Time and Priority for P%d: ",
               i + 1);
        scanf("%d%d%d", &at[i], &bt[i], &pri[i]);
        rt[i] = bt[i];
    }

    while (completed < n) {
        min = 9999;
        index = -1;

        for (i = 0; i < n; i++) {
            if (at[i] <= time && rt[i] > 0 && pri[i] < min) {
                min = pri[i];
                index = i;
            }
        }

        if (index == -1) {
            time++;
            continue;
        }

        rt[index]--;
        time++;

        if (rt[index] == 0) {
            completed++;
            tat[index] = time - at[index];
            wt[index] = tat[index] - bt[index];
        }
    }

    printf("\nProcess\tAT\tBT\tPriority\tWT\tTAT\n");

    for (i = 0; i < n; i++) {
        awt += wt[i];
        atat += tat[i];

        printf("P%d\t%d\t%d\t%d\t\t%d\t%d\n",
               i + 1, at[i], bt[i], pri[i], wt[i], tat[i]);
    }

    printf("\nAverage Waiting Time = %.2f", awt / n);
    printf("\nAverage Turnaround Time = %.2f\n", atat / n);

    return 0;
}

