#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>

sem_t s;
int data=0;

void *writer(void *p) {
    sem_wait(&s);
    data=100;
    printf("Writer wrote: %d\n",data);
    sem_post(&s);
    return NULL;
}

void *reader(void *p) {
    sem_wait(&s);
    printf("Reader read: %d\n",data);
    sem_post(&s);
    return NULL;
}

int main() {
    pthread_t r,w;
    sem_init(&s,0,1);

    pthread_create(&w,NULL,writer,NULL);
    pthread_join(w,NULL);
    pthread_create(&r,NULL,reader,NULL);
    pthread_join(r,NULL);

    return 0;
}
