#include <stdio.h>

int main() {
    int p[]={1,2,3,1,4,5,2,1,2,3,4,5};
    int f[3]={-1,-1,-1},t[3]={-1,-1,-1};
    int n=12,i,j,min,found,fault=0;

    for(i=0;i<n;i++) {
        found=0;

        for(j=0;j<3;j++)
            if(f[j]==p[i]) {
                found=1;
                t[j]=i;
            }

        if(!found) {
            min=0;
            for(j=1;j<3;j++)
                if(t[j]<t[min]) min=j;

            f[min]=p[i];
            t[min]=i;
            fault++;
        }
    }

    printf("Page Faults = %d\n",fault);
    return 0;
}
