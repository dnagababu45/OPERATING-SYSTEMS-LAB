#include <stdio.h>

int main() {
    int p[]={1,2,3,1,4,5,2,1,2,3,4,5};
    int f[3]={-1,-1,-1};
    int n=12,i,j,k=0,fault=0,found;

    for(i=0;i<n;i++) {
        found=0;
        for(j=0;j<3;j++)
            if(f[j]==p[i]) found=1;

        if(!found) {
            f[k]=p[i];
            k=(k+1)%3;
            fault++;
        }
    }

    printf("Page Faults = %d\n",fault);
    return 0;
}
