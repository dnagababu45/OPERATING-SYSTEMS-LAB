#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>

int main() {
    int fd;
    struct stat s;
    DIR *d;
    struct dirent *e;

    fd=open("test.txt",O_RDONLY);
    fcntl(fd,F_GETFL);
    lseek(fd,0,SEEK_SET);
    stat("test.txt",&s);

    printf("File Size: %ld bytes\n",s.st_size);

    d=opendir(".");
    while((e=readdir(d))!=NULL)
        if(e->d_name[0]!='.')
            printf("%s\n",e->d_name);

    closedir(d);
    close(fd);
    return 0;
}
