#include <stdio.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <string.h>

int main() {
    int shmid;
    char *str;

    shmid = shmget(IPC_PRIVATE, 100, 0666 | IPC_CREAT);
    str = (char *)shmat(shmid, NULL, 0);

    strcpy(str, "Hello from Shared Memory!");

    printf("Data written to shared memory: %s\n", str);

    shmdt(str);
    shmctl(shmid, IPC_RMID, NULL);

    return 0;
}
