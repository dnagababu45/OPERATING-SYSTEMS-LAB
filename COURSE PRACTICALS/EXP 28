#include <stdio.h>
#include <string.h>

int main() {
    char *data[]={
        "OS manages resources.",
        "CPU executes instructions.",
        "OS manages processes.",
        "Memory stores data."
    };
    char word[]="OS";
    int i;

    printf("Search Word: %s\n",word);

    for(i=0;i<4;i++)
        if(strstr(data[i],word))
            printf("%s\n",data[i]);

    return 0;
}
