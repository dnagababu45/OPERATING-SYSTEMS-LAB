 5. CPU and Memory Resource Management


BEGIN
    INPUT application_list

    FOR each app IN application_list DO
        CREATE cgroup FOR app
        SET CPU limit FOR app
        SET memory limit FOR app
        ASSIGN app PROCESS TO cgroup
    ENDFOR

    MONITOR CPU AND MEMORY USAGE

    IF any application exceeds its limit THEN
        THROTTLE application
    ENDIF

    PRINT "Resource usage is controlled"
END
